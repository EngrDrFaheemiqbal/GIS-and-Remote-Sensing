var anthony = ee.FeatureCollection("projects/ee-geosaptialaaco/assets/Anthony");
var drySeasonMonths = [6,7,8,9];  // June-Sept
var s2Collection = ee.ImageCollection('COPERNICUS/S2_SR')
  .filterBounds(anthony)
  .filter(ee.Filter.calendarRange(drySeasonMonths[0], drySeasonMonths[drySeasonMonths.length-1], 'month'))
  .filterDate('2020-01-01', '2024-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10))
  .select(['B2','B3','B4','B5','B6','B7','B8','B11','B12'])
  .map(function(img) {
    return img.clip(anthony);
  });
var greenVeg = [0.05, 0.07, 0.06, 0.08, 0.10, 0.12, 0.40, 0.05, 0.04];
var nonGreenVeg = [0.10, 0.12, 0.13, 0.14, 0.15, 0.16, 0.25, 0.20, 0.15];
var bareSoil = [0.20, 0.25, 0.30, 0.35, 0.40, 0.42, 0.30, 0.50, 0.45];
var unmixGreenFraction = function(image) {
  var fractions = image.unmix([greenVeg, nonGreenVeg, bareSoil]).rename(['Green_Veg', 'NonGreen_Veg', 'Bare_Soil']);
  // Clamp fractions to 0-1
  fractions = fractions.max(0).min(1);
  return fractions.select('Green_Veg').copyProperties(image, image.propertyNames());
};
var greenFractionCollection = s2Collection.map(unmixGreenFraction);
var persistentGreen = greenFractionCollection.min();

var threshold = 0.2;
var persistentGreenMask = persistentGreen.gte(threshold);
var visPersistent = {min: 0, max: 1, palette: ['white', 'green']};
var maskVis = {palette: ['000000', '00FF00']};
Map.centerObject(anthony, 12);
Map.addLayer(persistentGreen, visPersistent, 'Persistent Green Fraction (min dry season)');
Map.addLayer(persistentGreenMask.updateMask(persistentGreenMask), maskVis, 'Persistent Green Mask');

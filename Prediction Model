# Step 1: Import Required Libraries
import pandas as pd
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, r2_score
import matplotlib.pyplot as plt
import numpy as np

# Step 2: Load Your Data
file_path = r"C:\Users\FIqbal\Downloads\CIBO0177-EvaDowns\Eva_down_TSDM\survey_with_raster_values_for_model2.csv"
data = pd.read_csv(file_path)

# Step 3: Data Preprocessing
data['Unpalatab'] = data['Unpalatab'].astype(str).str.replace('%', '').astype(float)

# Identify features and target
features = data.drop(columns=['Unpalatab'])  # All other columns as features
target = data['Unpalatab']  # Target variable

# Step 4: Split the data into training, testing, and validation sets
X_temp, X_test, y_temp, y_test = train_test_split(features, target, test_size=0.30, random_state=42)  # 30% for testing
X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, test_size=1/3, random_state=42)  # 40% training, 10% validation

# Step 5: Train the Model with Cross-Validation
model = RandomForestRegressor(n_estimators=100, random_state=42)

# Perform 10-fold cross-validation
cv_scores = cross_val_score(model, X_train, y_train, cv=10)

# Train the model on the entire training set
model.fit(X_train, y_train)

# Step 6: Make Predictions
y_pred_train = model.predict(X_train)
y_pred_test = model.predict(X_test)
y_pred_val = model.predict(X_val)

# Step 7: Evaluate the Model
mae_test = mean_absolute_error(y_test, y_pred_test)
r2_test = r2_score(y_test, y_pred_test)

mae_val = mean_absolute_error(y_val, y_pred_val)
r2_val = r2_score(y_val, y_pred_val)

print(f'Test Mean Absolute Error: {mae_test}')
print(f'Test R² Score: {r2_test}')
print(f'Validation Mean Absolute Error: {mae_val}')
print(f'Validation R² Score: {r2_val}')

# Print Cross-Validation Scores
print(f'Cross-Validation Scores: {cv_scores}')
print(f'Average Cross-Validation Score: {np.mean(cv_scores)}')

# Step 8: Visualize Results
def plot_predictions(actual, predicted, title, color='blue'):
    plt.figure(figsize=(10, 6))
    plt.scatter(actual, predicted, alpha=0.7, color=color)
    plt.plot([actual.min(), actual.max()], [actual.min(), actual.max()], 'k--', lw=2)  # Line of perfect prediction
    plt.xlabel('Actual Unpalatability')
    plt.ylabel('Predicted Unpalatability')
    plt.title(title)
    plt.grid(True)
    plt.show()

# Plot for Training Data
plot_predictions(y_train, y_pred_train, 'Training Data: Actual vs Predicted')

# Plot for Testing Data
plot_predictions(y_test, y_pred_test, 'Testing Data: Actual vs Predicted', color='orange')

# Plot for Validation Data
plot_predictions(y_val, y_pred_val, 'Validation Data: Actual vs Predicted', color='green')

# Step 9: Feature Importance
feature_importances = model.feature_importances_

# Create a DataFrame for feature importance
importance_df = pd.DataFrame({
    'Feature': features.columns,
    'Importance': feature_importances
})

# Sort the DataFrame by importance
importance_df = importance_df.sort_values(by='Importance', ascending=False)

# Display the feature importance ranking
print(importance_df)

# Step 10: Plot Feature Importances
plt.figure(figsize=(12, 6))
plt.barh(importance_df['Feature'], importance_df['Importance'], color='skyblue')
plt.xlabel('Importance Score')
plt.title('Feature Importances in Random Forest Model')
plt.show()
